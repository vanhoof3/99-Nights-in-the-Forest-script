local toastThread = nil
local function showToast(msg, col)
    Toast.Text = msg
    Toast.TextColor3 = col or T.grn
    Toast.BackgroundTransparency = 0
    Toast.Visible = true
    if toastThread then task.cancel(toastThread) end
    toastThread = task.delay(2.2, function()
        Toast.Visible = false
        toastThread = nil
    end)
end

